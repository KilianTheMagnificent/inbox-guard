{
  "name": "inbox-guard",
  "version": "0.1.1",
  "description": "Zero-dependency defensive validation and session-scoped PII redaction for untrusted business emails, attachments, and CSV exports.",
  "homepage": "https://github.com/KilianTheMagnificent/inbox-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KilianTheMagnificent/inbox-guard.git"
  },
  "bugs": {
    "url": "https://github.com/KilianTheMagnificent/inbox-guard/issues"
  },
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "bin": {
    "inbox-guard": "./bin/inbox-guard.mjs"
  },
  "files": [
    "src/*.mjs",
    "src/*.d.ts",
    "bin/*.mjs",
    "examples/invoices.csv",
    "docs/checking-a-change.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "security",
    "email-security",
    "input-validation",
    "csv-injection",
    "redaction",
    "pii",
    "prompt-injection"
  ],
  "author": "Andre Romero-Carey (https://kilianthemagnificent.github.io)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
