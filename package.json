{
  "name": "inbox-guard",
  "version": "0.1.0",
  "description": "Zero-dependency defensive validation and session-scoped PII redaction for untrusted business emails, attachments, and CSV exports.",
  "homepage": "https://kilianthemagnificent.github.io",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "inbox-guard": "./bin/inbox-guard.mjs"
  },
  "files": [
    "src/*.mjs",
    "bin/*.mjs",
    "test/*.test.mjs",
    "examples/invoices.csv",
    "docs/checking-a-change.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "security",
    "email-security",
    "input-validation",
    "csv-injection",
    "redaction",
    "pii",
    "prompt-injection"
  ],
  "author": "Andre Romero-Carey (https://kilianthemagnificent.github.io)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
